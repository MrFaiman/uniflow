IPC_SOCKET_PATH=/tmp/proto_ipc.sock
PORT=9000
UNIFLOW_WORKERS=3
RECEIVE_DIR=/tmp/uniflow-in
# Small files (<10MB): one sender/receiver pair per file (parallel pairs for multiple files)
# Large files (10MB-1GB default): coordinated split across all workers
# UNIFLOW_MAX_FILE_BYTES=5368709120  # optional override (devops uses 5 GiB)
