# Compose overrides (docker compose --env-file .env ...)
RX_HOST=rx_machine
ROUTER_HOST=router
PACKET_LOSS=0.03
BIT_FLIP=0.03
MISROUTING=0.03
RANDOM_SEED=1400
STATS_INTERVAL_SEC=10
LOG_PACKETS=0
UNIFLOW_WATCH_POLLING=1.0
UNIFLOW_MAX_FILE_BYTES=1073741824
UNIFLOW_FEC_REPAIR_PERCENT=50
# Per Sender in megabits/sec; 0 disables pacing.
UNIFLOW_SEND_RATE_MBPS=1

# Optional IPC override. Defaults: /tmp/uniflow/recv.sock (RX),
# /tmp/uniflow/send.sock (TX base, with .sender.0 through .sender.2 appended).
# IPC_SOCKET_PATH=/tmp/custom.sock

# Native runtime only; Compose uses these fixed values internally.
PORT=9000
UNIFLOW_WORKERS=3
UNIFLOW_NET_BINARY=/usr/local/bin/uniflow-net
# Optional C++ worker log file (also written to stderr).
# UNIFLOW_LOG_FILE=/var/log/uniflow/uniflow-net.log
