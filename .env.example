IPC_SOCKET_PATH=/tmp/proto_ipc.sock
PORT=9000
UNIFLOW_WORKERS=3
UNIFLOW_WATCH_POLLING=1.0
UNIFLOW_MAX_FILE_BYTES=1073741824
UNIFLOW_FEC_REPAIR_PERCENT=20
UNIFLOW_NET_BINARY=/usr/local/bin/uniflow-net
# Per C++ Sender. 0 disables pacing. 10 gives about 30 Mbit/s total with 3 workers.
UNIFLOW_SEND_RATE_MBPS=10
